[Unit]
Description=Minimal fast-01 acquisition chain
Wants=network-online.target
After=network-online.target remote-fs.target
RequiresMountsFor=/runtime/bin /runtime/lib

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/rtchain/boot-fast01
TimeoutStartSec=300
KillMode=control-group
LimitMEMLOCK=infinity
RuntimeDirectory=rtchain-log
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
