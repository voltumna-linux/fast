[Unit]
Description=Check FAST six-master prerequisites and bind VFIO devices
Requires=rtchain-prepare.service
After=rtchain-prepare.service

[Service]
Type=oneshot
Slice=rtchain.slice
ExecStart=/usr/libexec/rtchain/rtchain-producer preflight
RemainAfterExit=yes
TimeoutStartSec=300
LimitMEMLOCK=infinity
