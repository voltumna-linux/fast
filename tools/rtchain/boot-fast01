#!/bin/bash
# fast-01 only; run once after a clean boot, as root, through rtchain.service.
set -e

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LD_LIBRARY_PATH=/runtime/lib
export LIBRESOLVE_PATH=/runtime/lib
export TANGO_HOST=192.168.190.66:20001
export CRUDA_SHM_NAME=/mnt/hugepages/cruda
export CRUDA_SHM_FLAGS=hugepages
data=/usr/share/fast/rtchain/data
log=/run/rtchain-log

mkdir -p /mnt/hugepages /mnt/hugepages2m "$log"
echo 256 > /sys/devices/system/node/node1/hugepages/hugepages-1048576kB/nr_hugepages
echo 1100 > /sys/devices/system/node/node1/hugepages/hugepages-2048kB/nr_hugepages
mount -t hugetlbfs -o pagesize=1G,mode=1777 none /mnt/hugepages
mount -t hugetlbfs -o pagesize=2M,mode=1777 none /mnt/hugepages2m
numactl --membind=1 -- /runtime/bin/cruda_init \
    --shm-name /mnt/hugepages/cruda --shm-flags h --socket-id 1

pci=(0000:81:00.0 0000:81:00.1 0000:91:00.0 0000:91:00.1 0000:e1:00.0 0000:e1:00.1)
modprobe vfio-pci
dpdk-devbind.py --bind=vfio-pci "${pci[@]}"

numactl --membind=1 -- taskset -c 223 /runtime/bin/tsc_init > "$log/tsc.log" 2>&1 &
sleep 10

export DPDK_NUMA_NODE=1
export DPDK_MEMORY_CHANNELS=12
export DPDK_HUGEPAGES=1
export DPDK_EAL_EXTRA='--huge-dir /mnt/hugepages --socket-mem 0,1024'
export DPDK_HOUSEKEEPING_CORE=0
export DPDK_MASTER_CTRL_CORES=131,132
export DPDK_SLAVES=16
export DPDK_DRAIN_FANIN=2
export DPDK_DRAIN_SLAVE_ID=7
export DPDK_PORT_MASK=0x1
export DPDK_PORT_MTU=512
export DPDK_PROMISCUOUS=1
export DPDK_RX_BURST=16
export DPDK_RX_FREE_THRESH=8
export DPDK_MASTER_MBUF_N=81920
export DPDK_LIBRARY_PATH=/runtime/lib/libdpdk_ebpm.so
export DPDK_RX_FUNC_NAME=dpdk_ebpm_rx_handler
export DPDK_INIT_FUNC_NAME=dpdk_ebpm_slave_init_handler
# The callback runs inside the masters: share decoder settings with ebpm.
export DPDK_EBPM_TX_SYNTH=0
export DPDK_EBPM_SYNTH=0
export DPDK_EBPM_TEST_UNITS_PER_PORT=14
export DPDK_EBPM_NT_BATCH=0
export DPDK_EBPM_LIGHTBUF=1
export DPDK_EBPM_LB_CAP=36864
export DPDK_EBPM_CALIBRATION_BASE="$data/bpm"
export DPDK_EBPM_CRUDA_CONF="$data/ebpm_cruda.conf"

for p in 0 1 2 3 4 5; do
    a=$((160 + 16*p))
    f=$((16*p + 1))
    # Four physical RX cores and two drains per port. Preserve global lcore
    # IDs: ebpm's lightbuf groups and the twelve naff inputs depend on them.
    DPDK_ALLOW="${pci[p]},safe-mode-support=1,rx_low_latency=0" \
    DPDK_PORT00_IP_ADDR="10.220.113.$((p+1))" \
    DPDK_FILE_PREFIX="sx$p" DPDK_SHM_SUFFIX="_sx$p" \
    DPDK_MASTER_CRUDA_CONF="$data/master$p.conf" \
    DPDK_CORE_LIST="0@$((144+p)),$f@[$a,$((a+2))],$((f+1))@$((a+1)),$((f+8))@[$((a+4)),$((a+6))],$((f+9))@$((a+5)),$((f+4))@$((a+8)),$((f+5))@$((a+9)),$((f+12))@$((a+10)),$((f+13))@$((a+11))" \
    DPDK_RXPORT_CONFIG="port0:$f,$((f+9)),$((f+1)),$((f+8))" \
    DPDK_TXPORT_CONFIG="port0:$((f+4)),$((f+5)),$((f+12)),$((f+13))" \
        numactl --membind=1 -- /runtime/bin/dpdk_master > "$log/master$p.log" 2>&1 &
    sleep 10
done

DPDK_EBPM_MASTERS=/mnt/hugepages/dpdk_m_sx0,/mnt/hugepages/dpdk_m_sx1,/mnt/hugepages/dpdk_m_sx2,/mnt/hugepages/dpdk_m_sx3,/mnt/hugepages/dpdk_m_sx4,/mnt/hugepages/dpdk_m_sx5 \
DPDK_SLAVE_SHM_BASE=/mnt/hugepages/dpdk_ebpm \
DPDK_SLAVE_ID=2 DPDK_SLAVE_ID_DRAIN=7 DPDK_UDP_PORT=2047 \
DPDK_EBPM_SPLIT_PORTS=0,1,2,3,4,5 DPDK_EBPM_DRAIN_TURNS=8 \
DPDK_EBPM_DRAIN_BCAP=64 DPDK_EBPM_RING_SLEEP_MAX=900 DPDK_EBPM_TURN_HZ=1156600 \
    numactl --membind=1 -- taskset -c 138 /runtime/bin/dpdk_ebpm > "$log/ebpm.log" 2>&1 &
sleep 20

# Captured on fast-01 in gold/fast-01-gold-001/PARAMETRI.txt.
export NAFF_CCD_PERIOD_MS=10
export NAFF_CCD_SPECTRO_DEPTH=256
export NAFF_CCD_TRIG_MOD=1048576
export NAFF_CCD_TUNE_SLOTS=8192
groups=(1 9 17 25 33 41 49 57 65 73 81 89)
cores=(163 167 179 183 195 199 211 215 227 231 243 247)
for i in "${!groups[@]}"; do
    NAFF_CCD_GROUP="${groups[i]}" NAFF_CCD_CORE="${cores[i]}" \
        numactl --membind=1 -- taskset -c "${cores[i]}" /runtime/bin/naff-ccd \
        > "$log/naff${groups[i]}.log" 2>&1 &
    # One creator first, then distinct start seconds: preserves buffer labels.
    if [ "$i" = 0 ]; then sleep 8; else sleep 2; fi
done

/runtime/bin/crudaknob sr/diagnostics/ebpm/SynthMode 0
/runtime/bin/crudaknob sr/diagnostics/ebpm/SynthSimBase ''
/runtime/bin/crudaknob sr/diagnostics/naff/common/PipelineStages 31

CATDS_CRUDA_REGISTRY=/mnt/hugepages/cruda CATDS_CRUDA_HUGEPAGES=1 \
    numactl --membind=0 -- /runtime/bin/catds-srv fast01 > "$log/catds.log" 2>&1 &
for instance in dpdkmaster6 ebpm; do
    DEVX_ARENA_NUMA=0 numactl --membind=0 -- /runtime/bin/devx-srv "$instance" \
        > "$log/devx-$instance.log" 2>&1 &
done
for instance in ebpm naff nafftune; do
    numactl --membind=0 -- /runtime/bin/tcbuf-srv "$instance" \
        > "$log/tcbuf-$instance.log" 2>&1 &
done
sleep 30

python3 - <<'PY'
import tango
for instance in ('ebpm', 'naff', 'nafftune'):
    tango.DeviceProxy('tcbuf/test/' + instance).command_inout('SmartRescan')
PY
