+++ b/LinuxNativeLaunch.cpp
@@ -0,0 +1,263 @@
+#include "LinuxNativeLaunch.h"
+
+#include <cerrno>
+#include <climits>
+#include <csignal>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/magic.h>
+#include <linux/mempolicy.h>
+#include <map>
+#include <sched.h>
+#include <stdexcept>
+#include <sys/statfs.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+namespace Starter_ns {
+namespace {
+class Fd {
+public:
+    explicit Fd(int value = -1) : value(value) {
+        if (value >= 0 && value <= STDERR_FILENO) {
+            this->value = fcntl(value, F_DUPFD_CLOEXEC, 3);
+            int error = errno;
+            close(value);
+            errno = error;
+        }
+    }
+    ~Fd() { if (value >= 0) close(value); }
+    Fd(const Fd &) = delete;
+    Fd &operator=(const Fd &) = delete;
+    int get() const { return value; }
+    void reset() { if (value >= 0) close(value); value = -1; }
+private:
+    int value;
+};
+
+[[noreturn]] void system_error(const std::string &operation, int error = errno) {
+    throw std::runtime_error(operation + ": " + std::strerror(error));
+}
+
+unsigned number(const std::string &value, unsigned maximum) {
+    if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos)
+        throw std::runtime_error("expected an unsigned decimal integer: " + value);
+    unsigned result = 0;
+    for (char digit : value) {
+        if (result > maximum / 10 ||
+            (result == maximum / 10 && unsigned(digit - '0') > maximum % 10))
+            throw std::runtime_error("integer out of range: " + value);
+        result = result * 10 + unsigned(digit - '0');
+    }
+    return result;
+}
+
+std::vector<unsigned> index_list(const std::string &value, unsigned maximum) {
+    std::vector<unsigned> result;
+    std::size_t begin = 0;
+    do {
+        auto end = value.find(',', begin);
+        auto part = value.substr(begin, end - begin);
+        auto dash = part.find('-');
+        unsigned first = number(part.substr(0, dash), maximum);
+        unsigned last = dash == std::string::npos ? first : number(part.substr(dash + 1), maximum);
+        if (first > last)
+            throw std::runtime_error("descending index range: " + part);
+        for (unsigned index = first; index <= last; ++index)
+            result.push_back(index);
+        if (end == std::string::npos) break;
+        begin = end + 1;
+    } while (true);
+    return result;
+}
+
+std::string read_at(int directory, const char *name) {
+    Fd fd(openat(directory, name, O_RDONLY | O_CLOEXEC));
+    if (fd.get() < 0) system_error(std::string("open cgroup ") + name);
+    std::string value;
+    char buffer[4096];
+    ssize_t count;
+    while ((count = read(fd.get(), buffer, sizeof(buffer))) != 0) {
+        if (count < 0) {
+            if (errno == EINTR) continue;
+            system_error(std::string("read cgroup ") + name);
+        }
+        value.append(buffer, static_cast<std::size_t>(count));
+        if (value.size() > 65536) throw std::runtime_error("cgroup value too long");
+    }
+    while (!value.empty() && (value.back() == '\n' || value.back() == '\r')) value.pop_back();
+    return value;
+}
+
+struct Profile {
+    cpu_set_t cpus{};
+    std::vector<unsigned long> nodes;
+    unsigned maxnode = 0;
+    int scheduler = SCHED_OTHER;
+    sched_param scheduling{};
+    std::string cgroup;
+};
+
+Profile parse(const std::vector<std::string> &lines) {
+    std::map<std::string, std::string> fields;
+    for (const auto &line : lines) {
+        auto equals = line.find('=');
+        if (equals == std::string::npos || !fields.emplace(line.substr(0, equals), line.substr(equals + 1)).second)
+            throw std::runtime_error("malformed or duplicate NativeLaunchProfile field: " + line);
+    }
+    const char *keys[] = {"version", "cgroup", "cpus", "numa_node", "scheduler", "priority"};
+    for (auto key : keys)
+        if (!fields.count(key)) throw std::runtime_error(std::string("missing NativeLaunchProfile field: ") + key);
+    if (fields.size() != 6 || fields.at("version") != "1")
+        throw std::runtime_error("unknown NativeLaunchProfile field or version");
+    Profile profile;
+    profile.cgroup = fields.at("cgroup");
+    if (profile.cgroup.empty() || profile.cgroup.front() != '/' || profile.cgroup.find('\0') != std::string::npos)
+        throw std::runtime_error("cgroup must be an absolute directory path");
+    CPU_ZERO(&profile.cpus);
+    for (auto cpu : index_list(fields.at("cpus"), CPU_SETSIZE - 1)) CPU_SET(cpu, &profile.cpus);
+    unsigned node = number(fields.at("numa_node"), 4095);
+    profile.maxnode = node + 1;
+    const unsigned bits = sizeof(unsigned long) * CHAR_BIT;
+    profile.nodes.resize(node / bits + 1, 0);
+    profile.nodes[node / bits] |= 1UL << (node % bits);
+    const auto &policy = fields.at("scheduler");
+    if (policy == "other") profile.scheduler = SCHED_OTHER;
+    else if (policy == "fifo") profile.scheduler = SCHED_FIFO;
+    else if (policy == "rr") profile.scheduler = SCHED_RR;
+    else throw std::runtime_error("scheduler must be other, fifo or rr");
+    profile.scheduling.sched_priority = static_cast<int>(number(fields.at("priority"), 99));
+    int priority = profile.scheduling.sched_priority;
+    if (priority < sched_get_priority_min(profile.scheduler) || priority > sched_get_priority_max(profile.scheduler))
+        throw std::runtime_error("priority is outside the scheduler's range");
+    return profile;
+}
+
+// Fixed-size message: the child uses only syscalls and stack data after fork.
+enum Stage { Detach, Fork, Redirect, Cgroup, Affinity, AffinityCheck, Numa, Scheduler, Exec };
+const char *stage_names[] = {"setsid", "second fork", "redirect logs", "join cgroup",
+    "set CPU affinity", "verify CPU affinity", "bind private NUMA allocations", "set scheduler", "exec"};
+struct Failure { int stage; int error; };
+
+[[noreturn]] void child_error(int pipe_fd, Stage stage, int error) {
+    Failure failure{stage, error};
+    ssize_t written;
+    do { written = write(pipe_fd, &failure, sizeof(failure)); } while (written < 0 && errno == EINTR);
+    _exit(127);
+}
+}
+
+void linux_native_launch(const char *executable, const char *instance,
+                         const char *log_file, const std::vector<std::string> *lines) {
+    Profile profile;
+    if (lines) profile = parse(*lines);
+    Fd directory(lines ? open(profile.cgroup.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC) : -1);
+    if (lines) {
+        if (directory.get() < 0) system_error("open cgroup " + profile.cgroup);
+        struct statfs fs{};
+        if (fstatfs(directory.get(), &fs) < 0) system_error("stat cgroup");
+        if (fs.f_type != CGROUP2_SUPER_MAGIC) throw std::runtime_error("profile requires a cgroup v2 directory");
+        if (read_at(directory.get(), "cgroup.type") != "domain")
+            throw std::runtime_error("profile requires a domain cgroup");
+        cpu_set_t effective;
+        CPU_ZERO(&effective);
+        for (auto cpu : index_list(read_at(directory.get(), "cpuset.cpus.effective"), CPU_SETSIZE - 1)) CPU_SET(cpu, &effective);
+        if (!CPU_EQUAL(&effective, &profile.cpus))
+            throw std::runtime_error("cpuset.cpus.effective must equal profile cpus");
+        bool allowed = false;
+        for (auto node : index_list(read_at(directory.get(), "cpuset.mems.effective"), 4095))
+            if (node + 1 == profile.maxnode) allowed = true;
+        if (!allowed) throw std::runtime_error("private NUMA node is outside cpuset.mems.effective");
+    }
+    Fd membership(lines ? openat(directory.get(), "cgroup.procs", O_WRONLY | O_CLOEXEC) : -1);
+    if (lines && membership.get() < 0) system_error("open cgroup.procs " + profile.cgroup);
+    Fd output(open("/dev/null", O_RDWR | O_CLOEXEC));
+    if (output.get() < 0) system_error("open /dev/null");
+    Fd log(open(log_file, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0664));
+    if (log.get() < 0) system_error("open native launch log " + std::string(log_file));
+    // Starter supplies a checked pathname from StartDsPath. Prepare both the
+    // direct-exec arguments and the historic execvp shell fallback here.
+    char *argv[] = {const_cast<char *>(executable), const_cast<char *>(instance), nullptr};
+    std::vector<std::string> environment_values;
+    for (char **entry = environ; *entry; ++entry) environment_values.emplace_back(*entry);
+    std::vector<char *> environment;
+    for (auto &entry : environment_values) environment.push_back(&entry[0]);
+    environment.push_back(nullptr);
+    char **envp = environment.data();
+    char *shell_argv[] = {const_cast<char *>("/bin/sh"), const_cast<char *>(executable),
+                          const_cast<char *>(instance), nullptr};
+    int pipes[2];
+    if (pipe2(pipes, O_CLOEXEC) < 0) system_error("create exec error pipe");
+    Fd reader(pipes[0]);
+    Fd writer(pipes[1]);
+    if (reader.get() < 0 || writer.get() < 0) system_error("prepare exec error pipe");
+    // Cache child data pointers before fork (no C++ library calls in the child).
+    int cgroup_fd = membership.get(), out_fd = output.get(), log_fd = log.get();
+    int read_fd = reader.get(), write_fd = writer.get();
+    const unsigned long *nodes = profile.nodes.data();
+    pid_t child = fork();
+    if (child < 0) system_error("fork");
+    if (child == 0) {
+        close(read_fd);
+        if (setsid() < 0) child_error(write_fd, Detach, errno);
+        // Do not run application pthread_atfork handlers in the already forked
+        // child of this multithreaded server.
+#ifdef SYS_fork
+        pid_t grandchild = static_cast<pid_t>(syscall(SYS_fork));
+#else
+        pid_t grandchild = static_cast<pid_t>(syscall(SYS_clone, SIGCHLD, nullptr, nullptr, nullptr, 0));
+#endif
+        if (grandchild < 0) child_error(write_fd, Fork, errno);
+        if (grandchild > 0) _exit(0);
+        if (dup2(out_fd, STDOUT_FILENO) < 0 || dup2(log_fd, STDERR_FILENO) < 0)
+            child_error(write_fd, Redirect, errno);
+        if (lines) {
+            ssize_t count;
+            do { count = write(cgroup_fd, "0", 1); } while (count < 0 && errno == EINTR);
+            if (count != 1) child_error(write_fd, Cgroup, count < 0 ? errno : EIO);
+            if (sched_setaffinity(0, sizeof(profile.cpus), &profile.cpus) < 0)
+                child_error(write_fd, Affinity, errno);
+            cpu_set_t actual;
+            if (sched_getaffinity(0, sizeof(actual), &actual) < 0)
+                child_error(write_fd, AffinityCheck, errno);
+            // Compare inline, without invoking libc's CPU_EQUAL helper.
+            const auto *wanted = reinterpret_cast<const unsigned char *>(&profile.cpus);
+            const auto *got = reinterpret_cast<const unsigned char *>(&actual);
+            for (unsigned i = 0; i < sizeof(actual); ++i)
+                if (wanted[i] != got[i]) child_error(write_fd, AffinityCheck, EINVAL);
+            if (syscall(SYS_set_mempolicy, MPOL_BIND, nodes, profile.maxnode) < 0)
+                child_error(write_fd, Numa, errno);
+            if (sched_setscheduler(0, profile.scheduler, &profile.scheduling) < 0)
+                child_error(write_fd, Scheduler, errno);
+        }
+        execve(executable, argv, envp);
+        // Preserve execvp's historic handling of executable text scripts.
+        if (errno == ENOEXEC) execve("/bin/sh", shell_argv, envp);
+        child_error(write_fd, Exec, errno);
+    }
+    // This descriptor must close before reading, to observe EOF at exec.
+    writer.reset();
+    int status = 0;
+    while (waitpid(child, &status, 0) < 0) {
+        if (errno == EINTR) continue;
+        system_error("waitpid native launcher");
+    }
+    Failure failure{};
+    std::size_t received = 0;
+    while (received < sizeof(failure)) {
+        ssize_t count = read(reader.get(), reinterpret_cast<char *>(&failure) + received, sizeof(failure) - received);
+        if (count < 0) {
+            if (errno == EINTR) continue;
+            system_error("read native exec result");
+        }
+        if (count == 0) break;
+        received += static_cast<std::size_t>(count);
+    }
+    if (received == sizeof(failure)) system_error(stage_names[failure.stage], failure.error);
+    if (received != 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        throw std::runtime_error("native launcher terminated before exec");
+}
+}
